PORT=3000
NODE_ENV=development

# Base de Datos (MySQL o PostgreSQL)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto_grados
# DB_SSL=false
# DATABASE_URL=

# Seguridad y JWT
JWT_SECRET=super_secret_jwt_key_para_desarrollo
JWT_EXPIRES_IN=24h

# Inteligencia Artificial (El sistema selecciona el proveedor disponible automáticamente)
# 1. Groq Cloud (100% Gratis - Recomendado: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2. Google Gemini (Gratis 15 req/min - Ideal para textos gigantes: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Ollama Local (Ejecución offline en localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# 4. DeepSeek API (Respaldo alternativo de bajo costo: https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# 5. OpenAI API (Opcional: https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
